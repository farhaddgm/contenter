model ProfileTrait {
  id          String        @id @default(cuid())
  profileId   String
  category    TraitCategory
  name        String
  description String
  evidence    String        @default("")
  confidence  Float         @default(0.5)
  status      TraitStatus   @default(PROPOSED)
  source      TraitSource   @default(AI)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  profile ContentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category])
}

// ─────────────────────────────── Ideas ───────────────────────────────

enum ContentFormat {
  POST
  CAROUSEL
  SHORT_VIDEO_SCRIPT
  LONG_VIDEO_SCRIPT
  ARTICLE
  THREAD
  NEWSLETTER
  CAPTION
}

enum IdeaStatus {
  PROPOSED
  SHORTLISTED
  REJECTED
  USED
}

model IdeationRequest {
  id          String         @id @default(cuid())
  topicId     String
  count       Int
  direction   String         @default("")
  format      ContentFormat?
  jobId       String?
  createdById String?
  createdAt   DateTime       @default(now())

  topic Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ideas Idea[]
}

model Idea {
  id        String        @id @default(cuid())
  topicId   String
  requestId String?
  title     String
  angle     String        @default("")
  hook      String        @default("")
  format    ContentFormat @default(POST)
  outline   String[]
  rationale String        @default("")
  score     Float         @default(0)
  status    IdeaStatus    @default(PROPOSED)
