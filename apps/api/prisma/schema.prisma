// Contenter data model — see docs/03-domain-model.md
// Enums mirror packages/shared/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

/// PASSWORD = email + password only; GOOGLE = Google sign-in only; BOTH = either.
enum LoginMethod {
  PASSWORD
  GOOGLE
  BOTH
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  /// null for Google-only accounts
  passwordHash String?
  role         Role        @default(EDITOR)
  isActive     Boolean     @default(true)
  loginMethod  LoginMethod @default(PASSWORD)
  /// Google account id (`sub`), bound on the first Google sign-in
  googleSub    String?     @unique
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  aiJobs              AiJob[]
  topics              Topic[]
  interactionLogs     InteractionLog[]
  appErrors           AppError[]
  smartConversations  SmartConversation[]
  walkerIssues        WalkerIssue[]
  brandDocuments      BrandDocument[]
  businesses          Business[]
  businessSections    BusinessSection[]         @relation("SectionUpdatedBy")
  reviewedSections    BusinessSection[]         @relation("SectionReviewedBy")
  businessFacts       BusinessFact[]
  sectionRevisions    BusinessSectionRevision[]
  businessDiscovery   BusinessDiscovery[]
  blockedSources      BlockedSource[]
  businessReferences  BusinessReference[]
  googleDriveAccounts GoogleDriveAccount[]
  businessNotes       BusinessNote[]
  businessAssets      BusinessAsset[]
  topicMemberships    TopicMember[]             @relation("TopicMemberUser")
  topicGrants         TopicMember[]             @relation("TopicMemberGrantedBy")
  businessMemberships BusinessMember[]          @relation("BusinessMemberUser")
  businessGrants      BusinessMember[]          @relation("BusinessMemberGrantedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Businesses ───────────────────────────────
// See docs/12-businesses.md. Enums mirror packages/shared/src/business.ts.

enum BusinessStatus {
  ACTIVE
  ARCHIVED
}

enum BusinessOrigin {
  MANUAL
  RESEARCH
  SOURCES
}

enum BusinessBuildState {
  NONE
  BUILDING
  READY
  FAILED
}

enum BusinessSectionKey {
  OVERVIEW
  SERVICES
  TARGET_MARKET
  PERSONAS
  VALUE_PROPOSITION
  COMPETITORS
  BRAND_VOICE
  BRAND_BOOK
  KEY_MESSAGES
  CONTENT_PILLARS
  GUIDELINES
  CHANNELS
  GOALS
  FAQ
  CALENDAR
}

enum SectionSource {
  ADMIN
  AI
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum DiscoveryStatus {
  RESEARCHING
  READY
  FAILED
  USED
}

/// The company a project (topic) produces content for.
model Business {
  id           String             @id @default(cuid())
  name         String
  tagline      String             @default("")
  industry     String             @default("")
  website      String             @default("")
  location     String             @default("")
  language     String             @default("fa")
  /// Keyword of the discovery this business was built from
  keyword      String?
  status       BusinessStatus     @default(ACTIVE)
  origin       BusinessOrigin     @default(MANUAL)
  buildState   BusinessBuildState @default(NONE)
  buildError   String?
  lastJobId    String?
  /// Web sources ({url,title}[]) collected by research builds
  sources      Json               @default("[]")
  /// Unverified facts / gaps reported by the last research build
  gaps         String[]
  researchedAt DateTime?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  topics      Topic[]
  sections    BusinessSection[]
  suggestions BusinessSuggestion[]
  discoveries BusinessDiscovery[]
  references  BusinessReference[]
  notes       BusinessNote[]
  assets      BusinessAsset[]
  facts       BusinessFact[]
  terms       BusinessTerm[]
  audits      BusinessAudit[]
  members     BusinessMember[]

  @@index([status, updatedAt])
}

/// Grants a non-admin user access to a business, like TopicMember (docs/17-project-access.md).
model BusinessMember {
  id          String      @id @default(cuid())
  businessId  String
  userId      String
  access      AccessLevel
  grantedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User     @relation("BusinessMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("BusinessMemberGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([userId])
}

/// One profile section of a business (services, personas, brand book, …). Markdown text.
model BusinessSection {
  id           String             @id @default(cuid())
  businessId   String
  key          BusinessSectionKey
  content      String             @default("")
  source       SectionSource      @default(ADMIN)
  updatedById  String?
  /// When a person confirmed the current text; null = AI text nobody has reviewed yet
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy  User?                     @relation("SectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy User?                     @relation("SectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  revisions  BusinessSectionRevision[]

  @@unique([businessId, key])
}

/// Previous content of a section, stored whenever it is overwritten (restorable).
model BusinessSectionRevision {
  id          String        @id @default(cuid())
  sectionId   String
  content     String
  source      SectionSource
  createdById String?
  createdAt   DateTime      @default(now())

  section   BusinessSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sectionId, createdAt])
}

/// AI proposal for a section; applied only when the admin accepts it.
model BusinessSuggestion {
  id         String             @id @default(cuid())
  businessId String
  key        BusinessSectionKey
  content    String
  rationale  String             @default("")
  status     SuggestionStatus   @default(PENDING)
  jobId      String?
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

/// Keyword research run: AI searches the web and proposes real businesses for the keyword.
model BusinessDiscovery {
  id            String          @id @default(cuid())
  keyword       String
  location      String          @default("")
  language      String          @default("fa")
  count         Int             @default(5)
  notes         String          @default("")
  status        DiscoveryStatus @default(RESEARCHING)
  summary       String          @default("")
  candidates    Json            @default("[]")
  sources       Json            @default("[]")
  selectedIndex Int?
  businessId    String?
  jobId         String?
  error         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum ReferenceKind {
  URL
  GOOGLE_DOC
  TEXT
}

enum ReferenceStatus {
  PENDING
  READY
  FAILED
}

/// Admin-supplied source for AI builds/suggestions: a web page, a Google Docs/Drive file or a
/// pasted text. `content` is the text snapshot AI reads (refreshed on demand).
model BusinessReference {
  id              String          @id @default(cuid())
  businessId      String
  kind            ReferenceKind
  url             String          @default("")
  title           String          @default("")
  content         String          @default("")
  status          ReferenceStatus @default(PENDING)
  error           String?
  isActive        Boolean         @default(true)
  fetchedAt       DateTime?
  googleAccountId String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleAccount GoogleDriveAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

/// Google account connected (OAuth, drive.readonly) to read private Google Docs/Drive files.
model GoogleDriveAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  googleSub     String
  /// AES-256-GCM encrypted refresh token (see secret-box.ts)
  refreshToken  String
  scope         String    @default("")
  /// Set when Google rejects the token (revoked / expired) — reconnect to clear
  error         String?
  lastUsedAt    DateTime?
  connectedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connectedBy User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  references  BusinessReference[]
}

enum NoteStatus {
  PENDING
  APPLIED
  FAILED
}

enum NoteApplyMode {
  DIRECT
  SUGGEST
}

/// An admin's explanation/correction; BUSINESS_REVISE updates the whole profile from it. Active
/// notes are also given to later builds and suggestions as standing corrections.
model BusinessNote {
  id          String               @id @default(cuid())
  businessId  String
  text        String
  apply       NoteApplyMode        @default(DIRECT)
  /// ResearchScope the revision was allowed to consult (NONE / REFERENCES / REFERENCE_SITES / WEB)
  scope       String               @default("NONE")
  status      NoteStatus           @default(PENDING)
  summary     String               @default("")
  changedKeys BusinessSectionKey[]
  error       String?
  isActive    Boolean              @default(true)
  jobId       String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

enum BusinessAssetKind {
  ARTICLE
  IMAGE
  BANNER
  ARTWORK
  CREATIVE
  VIDEO
  MOTION
}

/// A past piece of the business (article, image, banner, artwork, creative, video, motion).
/// BUSINESS_ASSET_ANALYZE turns it into a style analysis that every AI job of a linked topic gets.
model BusinessAsset {
  id             String            @id @default(cuid())
  businessId     String
  kind           BusinessAssetKind
  title          String            @default("")
  description    String            @default("")
  url            String            @default("")
  /// Article body, caption or transcript (pasted, uploaded as text, or fetched from `url`)
  text           String            @default("")
  fileName       String?
  mimeType       String?
  size           Int?
  /// Storage key of the uploaded original (FileStorageService)
  storageKey     String?
  /// Storage keys of JPEG previews: the downsized image, or frames captured from the video
  previews       String[]
  /// Public image URLs found on `url` (og:image), used when nothing was uploaded
  remoteImages   String[]
  analysisStatus AnalysisStatus    @default(NONE)
  analysis       Json?
  analysisError  String?
  lastJobId      String?
  isActive       Boolean           @default(true)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

enum FactCategory {
  IDENTITY
  OFFER
  PRICING
  NUMBERS
  CONTACT
  LEGAL
  OTHER
}

/// Exact value content may quote (price, fee, limit, number, date, contact, license …).
/// Admin-typed facts are verified; facts found by a research build start unverified.
model BusinessFact {
  id          String        @id @default(cuid())
  businessId  String
  label       String
  value       String
  category    FactCategory  @default(OTHER)
  sourceUrl   String        @default("")
  note        String        @default("")
  source      SectionSource @default(ADMIN)
  verified    Boolean       @default(true)
  /// After this day the value is no longer sent to AI (offers, rates, campaigns)
  validUntil  DateTime?
  isActive    Boolean       @default(true)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([businessId, category])
}

enum TermKind {
  USE
  AVOID
}

/// Brand terminology: USE = always write `term` (alternatives = wrong variants to catch);
/// AVOID = never write `term` (alternatives = replacements). Checked by code (checkTerms).
model BusinessTerm {
  id           String   @id @default(cuid())
  businessId   String
  term         String
  kind         TermKind @default(USE)
  alternatives String[]
  note         String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum AuditStatus {
  RUNNING
  READY
  FAILED
}

/// AI quality review of the whole profile (BUSINESS_AUDIT). `issues` holds AuditIssue[] with
/// their OPEN / FIXING / DISMISSED state.
model BusinessAudit {
  id          String      @id @default(cuid())
  businessId  String
  status      AuditStatus @default(RUNNING)
  score       Int?
  summary     String      @default("")
  strengths   String[]
  issues      Json        @default("[]")
  error       String?
  jobId       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

enum SourceBlockKind {
  URL
  DOMAIN
}

/// Research source the admin blacklisted: excluded from every future web research and purged
/// from stored business/discovery sources.
model BlockedSource {
  id          String          @id @default(cuid())
  kind        SourceBlockKind
  /// `host/path` for URL, `host` for DOMAIN (normalized — see sourceBlockValue in shared)
  value       String
  note        String          @default("")
  createdById String?
  createdAt   DateTime        @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([kind, value])
}

// ─────────────────────────────── Topics ───────────────────────────────

enum Platform {
  INSTAGRAM
  YOUTUBE
  TELEGRAM
  LINKEDIN
  X
  TIKTOK
  BLOG
  OTHER
}

enum TopicStatus {
  ACTIVE
  ARCHIVED
}

/// Per-topic / per-business access for EDITOR/VIEWER accounts (admins see everything)
enum AccessLevel {
  VIEW
  EDIT
}

model Topic {
  id               String      @id @default(cuid())
  title            String
  description      String
  audience         String      @default("")
  platform         Platform    @default(INSTAGRAM)
  language         String      @default("fa")
  status           TopicStatus @default(ACTIVE)
  activeProfileId  String?     @unique
  /// Business this project produces content for; its profile is sent to every AI job of the topic
  businessId       String?
  /// Set when the admin chose to produce content without sample contents (docs/19-optional-samples.md)
  samplesSkippedAt DateTime?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  business      Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  activeProfile ContentProfile?   @relation("ActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull)
  principles    Principle[]
  samples       SampleContent[]
  profiles      ContentProfile[]  @relation("TopicProfiles")
  ideationRuns  IdeationRequest[]
  ideas         Idea[]
  contents      Content[]
  brandDocs     BrandDocument[]
  members       TopicMember[]
  tags          Tag[]
  campaigns     Campaign[]

  @@index([status, createdAt])
  @@index([businessId])
}

/// Label an editor puts on ideas and contents of one topic (docs/20-tags-campaigns.md).
model Tag {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  /// One of the palette keys in `TagColor` (packages/shared); validated by Zod, not the DB
  color       String   @default("slate")
  createdById String?
  createdAt   DateTime @default(now())

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]
  ideas    Idea[]

  @@unique([topicId, name])
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

/// Groups the contents of one topic that serve one goal; the dates are optional, so a campaign
/// without them works as a plain collection.
model Campaign {
  id          String         @id @default(cuid())
  topicId     String
  name        String
  description String         @default("")
  status      CampaignStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]

  @@unique([topicId, name])
  @@index([topicId, status])
}

/// Grants a non-admin user access to a project. The creator has EDIT without a row; a row
/// overrides that (e.g. VIEW). See docs/17-project-access.md.
model TopicMember {
  id          String      @id @default(cuid())
  topicId     String
  userId      String
  access      AccessLevel
  grantedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  topic     Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User  @relation("TopicMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("TopicMemberGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([topicId, userId])
  @@index([userId])
}

enum PrincipleKind {
  MUST
  AVOID
  PREFER
}

/// topicId = null → global principle applied to every topic
model Principle {
  id        String        @id @default(cuid())
  topicId   String?
  kind      PrincipleKind
  text      String
  isActive  Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

// ─────────────────────────────── Samples ───────────────────────────────

enum MediaType {
  ARTICLE
  VIDEO
  IMAGE
  POST
  AUDIO
  UNKNOWN
}

enum FetchStatus {
  PENDING
  FETCHED
  FAILED
  SKIPPED
}

enum AnalysisStatus {
  NONE
  QUEUED
  DONE
  FAILED
}

model SampleContent {
  id             String         @id @default(cuid())
  topicId        String
  url            String
  platform       Platform       @default(OTHER)
  mediaType      MediaType      @default(UNKNOWN)
  manualText     String         @default("")
  adminNote      String         @default("")
  fetchStatus    FetchStatus    @default(PENDING)
  fetchError     String?
  fetched        Json?
  analysisStatus AnalysisStatus @default(NONE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  topic    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  analysis SampleAnalysis?

  @@index([topicId, createdAt])
}

model SampleAnalysis {
  id        String   @id @default(cuid())
  sampleId  String   @unique
  summary   String
  result    Json
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sample SampleContent @relation(fields: [sampleId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Brand documents ───────────────────────────────

enum BrandDocKind {
  BRAND_BOOK
  WRITING_GUIDE
  OTHER
}

/// Topic-level brand book / writing rules (plain text). Active ones are injected into the
/// context of BUILD_PROFILE, IDEATE, GENERATE_CONTENT and REVISE_CONTENT.
model BrandDocument {
  id          String       @id @default(cuid())
  topicId     String
  kind        BrandDocKind @default(BRAND_BOOK)
  title       String
  content     String
  fileName    String?
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  topic     Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([topicId, isActive])
}

// ─────────────────────────────── Profiles ───────────────────────────────

enum ProfileStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum TraitCategory {
  TONE
  STRUCTURE
  HOOK
  LANGUAGE
  FORMAT
  VISUAL
  CTA
  AUDIENCE
  OTHER
}

enum TraitStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum TraitSource {
  AI
  ADMIN
}

model ContentProfile {
  id             String        @id @default(cuid())
  topicId        String
  version        Int
  status         ProfileStatus @default(DRAFT)
  summary        String        @default("")
  styleGuide     String        @default("")
  sampleIds      String[]
  /// Brand documents that were in the AI context when this version was built
  brandDocIds    String[]
  /// Version this one was copied from ("new version from this one"); null for AI/manual builds
  basedOnVersion Int?
  jobId          String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  topic     Topic          @relation("TopicProfiles", fields: [topicId], references: [id], onDelete: Cascade)
  activeFor Topic?         @relation("ActiveProfile")
  traits    ProfileTrait[]
  contents  Content[]

  @@unique([topicId, version])
}

model ProfileTrait {
  id          String        @id @default(cuid())
  profileId   String
  category    TraitCategory
  name        String
  description String
  evidence    String        @default("")
  confidence  Float         @default(0.5)
  status      TraitStatus   @default(PROPOSED)
  source      TraitSource   @default(AI)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  profile ContentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category])
}

// ─────────────────────────────── Ideas ───────────────────────────────

enum ContentFormat {
  POST
  CAROUSEL
  SHORT_VIDEO_SCRIPT
  LONG_VIDEO_SCRIPT
  ARTICLE
  THREAD
  NEWSLETTER
  CAPTION
}

enum IdeaStatus {
  PROPOSED
  SHORTLISTED
  REJECTED
  USED
}

model IdeationRequest {
  id          String         @id @default(cuid())
  topicId     String
  count       Int
  direction   String         @default("")
  format      ContentFormat?
  jobId       String?
  createdById String?
  createdAt   DateTime       @default(now())

  topic Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ideas Idea[]
}

model Idea {
  id        String        @id @default(cuid())
  topicId   String
  requestId String?
  title     String
  angle     String        @default("")
  hook      String        @default("")
  format    ContentFormat @default(POST)
  outline   String[]
  rationale String        @default("")
  score     Float         @default(0)
  status    IdeaStatus    @default(PROPOSED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  topic    Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  request  IdeationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  contents Content[]
  tags     Tag[]

  @@index([topicId, status, createdAt])
}

// ─────────────────────────────── Contents ───────────────────────────────

enum ContentStatus {
  GENERATING
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum VersionSource {
  AI
  ADMIN
}

model Content {
  id               String        @id @default(cuid())
  topicId          String
  ideaId           String?
  profileId        String?
  campaignId       String?
  title            String
  brief            String        @default("")
  format           ContentFormat @default(POST)
  status           ContentStatus @default(GENERATING)
  currentVersionId String?       @unique
  lastJobId        String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  topic          Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  idea           Idea?            @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  profile        ContentProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  currentVersion ContentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContentVersion[] @relation("ContentVersions")
  tags           Tag[]

  @@index([topicId, status, createdAt])
  @@index([status, updatedAt])
  @@index([campaignId])
}

model ContentVersion {
  id        String        @id @default(cuid())
  contentId String
  version   Int
  title     String
  body      String
  hashtags  String[]
  cta       String        @default("")
  notes     String        @default("")
  selfCheck Json?
  feedback  String?
  source    VersionSource @default(AI)
  jobId     String?
  createdAt DateTime      @default(now())

  content   Content  @relation("ContentVersions", fields: [contentId], references: [id], onDelete: Cascade)
  currentOf Content? @relation("CurrentVersion")

  @@unique([contentId, version])
}

// ─────────────────────────────── AI & Ops ───────────────────────────────

enum AiJobType {
  ANALYZE_SAMPLE
  BUILD_PROFILE
  IDEATE
  GENERATE_CONTENT
  REVISE_CONTENT
  SMART_CHAT
  BUSINESS_DISCOVER
  BUSINESS_BUILD
  BUSINESS_SUGGEST
  BUSINESS_REVISE
  BUSINESS_ASSET_ANALYZE
  BUSINESS_AUDIT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model AiJob {
  id              String      @id @default(cuid())
  type            AiJobType
  status          AiJobStatus @default(QUEUED)
  targetType      String
  targetId        String
  topicId         String?
  input           Json
  output          Json?
  error           String?
  attempts        Int         @default(0)
  model           String?
  inputTokens     Int         @default(0)
  outputTokens    Int         @default(0)
  cacheReadTokens Int         @default(0)
  costUsd         Float       @default(0)
  promptKey       String?
  promptVersion   Int?
  createdById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
  @@index([topicId])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String
  version   Int
  system    String
  user      String
  notes     String   @default("")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@index([key, isActive])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────── Smart (اسمارت) ───────────────────────────────

enum InteractionSource {
  CLIENT
  SERVER
}

/// Opt-in detailed interaction log (SystemSetting smart.detailedLogging).
model InteractionLog {
  id         String            @id @default(cuid())
  userId     String?
  sessionId  String?
  source     InteractionSource
  type       String
  route      String?
  method     String?
  path       String?
  statusCode Int?
  durationMs Int?
  target     String?
  meta       Json?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

enum ErrorSource {
  SERVER
  CLIENT
  AI_JOB
}

enum ErrorStatus {
  NEW
  SEEN
  RESOLVED
  IGNORED
}

enum ErrorCategory {
  DATABASE
  VALIDATION
  AUTH
  NETWORK
  AI
  NOT_FOUND
  CLIENT_RUNTIME
  UNKNOWN
}

/// Errors raised by the server, the web client or AI jobs. Deduplicated by fingerprint.
model AppError {
  id          String        @id @default(cuid())
  fingerprint String
  source      ErrorSource
  category    ErrorCategory @default(UNKNOWN)
  message     String
  hint        String?
  detail      String?
  statusCode  Int?
  method      String?
  path        String?
  route       String?
  jobId       String?
  userId      String?
  context     Json?
  count       Int           @default(1)
  status      ErrorStatus   @default(NEW)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversations SmartConversation[]
  issues        WalkerIssue[]

  @@index([fingerprint, status])
  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}

enum ConversationKind {
  WALKER
  ERROR
}

enum SmartMessageRole {
  USER
  ASSISTANT
}

enum SmartMessageStatus {
  PENDING
  DONE
  FAILED
}

model SmartConversation {
  id        String           @id @default(cuid())
  userId    String
  kind      ConversationKind
  title     String           @default("")
  errorId   String?
  topicId   String?
  route     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  error    AppError?      @relation(fields: [errorId], references: [id], onDelete: SetNull)
  messages SmartMessage[]
  issues   WalkerIssue[]

  @@index([userId, updatedAt])
}

model SmartMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           SmartMessageRole
  content        String             @default("")
  status         SmartMessageStatus @default(DONE)
  /// Context snapshot captured when the admin sent the message (route, topic, walker step).
  context        Json?
  jobId          String?
  createdAt      DateTime           @default(now())

  conversation SmartConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  issues       WalkerIssue[]

  @@index([conversationId, createdAt])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum IssueSource {
  WALKER_CHAT
  ERROR_CHAT
}

/// "دفتر خطاهای واکر" — issues saved by the admin from an AI answer, to be fixed later.
model WalkerIssue {
  id             String      @id @default(cuid())
  title          String
  content        String
  source         IssueSource
  status         IssueStatus @default(OPEN)
  conversationId String?
  messageId      String?
  errorId        String?
  topicId        String?
  route          String?
  context        Json?
  resolutionNote String?
  resolvedAt     DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  conversation SmartConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      SmartMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  error        AppError?          @relation(fields: [errorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
