// ─────────────────────────────── Brand documents ───────────────────────────────

enum BrandDocKind {
  BRAND_BOOK
  WRITING_GUIDE
  OTHER
}

/// Topic-level brand book / writing rules (plain text). Active ones are injected into the
/// context of BUILD_PROFILE, IDEATE, GENERATE_CONTENT and REVISE_CONTENT.
model BrandDocument {
  id          String       @id @default(cuid())
  topicId     String
  kind        BrandDocKind @default(BRAND_BOOK)
  title       String
  content     String
  fileName    String?
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  topic     Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([topicId, isActive])
}

// ─────────────────────────────── Profiles ───────────────────────────────

enum ProfileStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum TraitCategory {
  TONE
  STRUCTURE
  HOOK
  LANGUAGE
  FORMAT
  VISUAL
  CTA
  AUDIENCE
  OTHER
}

enum TraitStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum TraitSource {
  AI
  ADMIN
}

model ContentProfile {
  id             String        @id @default(cuid())
  topicId        String
  version        Int
  status         ProfileStatus @default(DRAFT)
  summary        String        @default("")
  styleGuide     String        @default("")
  sampleIds      String[]
  /// Brand documents that were in the AI context when this version was built
  brandDocIds    String[]
  /// Version this one was copied from ("new version from this one"); null for AI/manual builds
  basedOnVersion Int?
  jobId          String?
  approvedAt     DateTime?
