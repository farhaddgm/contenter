// Contenter data model — see docs/03-domain-model.md
// Enums mirror packages/shared/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

/// PASSWORD = email + password only; GOOGLE = Google sign-in only; BOTH = either.
enum LoginMethod {
  PASSWORD
  GOOGLE
  BOTH
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  /// null for Google-only accounts
  passwordHash String?
  role         Role        @default(EDITOR)
  isActive     Boolean     @default(true)
  loginMethod  LoginMethod @default(PASSWORD)
  /// Google account id (`sub`), bound on the first Google sign-in
  googleSub    String?     @unique
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  aiJobs              AiJob[]
  topics              Topic[]
  interactionLogs     InteractionLog[]
  appErrors           AppError[]
  smartConversations  SmartConversation[]
  walkerIssues        WalkerIssue[]
  brandDocuments      BrandDocument[]
  businesses          Business[]
  businessSections    BusinessSection[]          @relation("SectionUpdatedBy")
  reviewedSections    BusinessSection[]          @relation("SectionReviewedBy")
  lockedSections      BusinessSection[]          @relation("SectionLockedBy")
  businessFacts       BusinessFact[]
  businessOfferings   BusinessOffering[]         @relation("OfferingUpdatedBy")
  businessCompetitors BusinessCompetitor[]       @relation("CompetitorUpdatedBy")
  businessSegments    BusinessSegment[]          @relation("SegmentUpdatedBy")
  competitorSources   BusinessCompetitorSource[] @relation("CompetitorSourceCreatedBy")
  sectionRevisions    BusinessSectionRevision[]
  businessDiscovery   BusinessDiscovery[]
  blockedSources      BlockedSource[]
  businessReferences  BusinessReference[]
  googleDriveAccounts GoogleDriveAccount[]
  businessNotes       BusinessNote[]
  businessStyles      BusinessStyle[]
  styleSources        StyleSource[]
  businessAssets      BusinessAsset[]
  topicMemberships    TopicMember[]              @relation("TopicMemberUser")
  topicGrants         TopicMember[]              @relation("TopicMemberGrantedBy")
  businessMemberships BusinessMember[]           @relation("BusinessMemberUser")
  businessGrants      BusinessMember[]           @relation("BusinessMemberGrantedBy")
  submittedContents   Content[]                  @relation("ContentSubmitter")
  contentReviews      ContentReview[]
  contentComments     ContentComment[]           @relation("CommentAuthor")
  contentMetrics      ContentMetric[]            @relation("MetricAuthor")
  resolvedComments    ContentComment[]           @relation("CommentResolver")
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  checklistTicks      ContentChecklistTick[]     @relation("ChecklistTicker")
  aiFeedback          AiFeedback[]
  apiKeys             ApiKey[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Businesses ───────────────────────────────
// See docs/12-businesses.md. Enums mirror packages/shared/src/business.ts.

enum BusinessStatus {
  ACTIVE
  ARCHIVED
}

enum BusinessOrigin {
  MANUAL
  RESEARCH
  SOURCES
}

enum BusinessBuildState {
  NONE
  BUILDING
  READY
  FAILED
}

enum BusinessSectionKey {
  OVERVIEW
  SERVICES
  TARGET_MARKET
  PERSONAS
  VALUE_PROPOSITION
  COMPETITORS
  BRAND_VOICE
  BRAND_BOOK
  KEY_MESSAGES
  CONTENT_PILLARS
  GUIDELINES
  CHANNELS
  GOALS
  FAQ
  CALENDAR
}

enum SectionSource {
  ADMIN
  AI
}

enum SectionLock {
  NONE
  AI_ONLY
  ADMIN_ONLY
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum DiscoveryStatus {
  RESEARCHING
  READY
  FAILED
  USED
}

/// The company a project (topic) produces content for.
model Business {
  id           String             @id @default(cuid())
  name         String
  tagline      String             @default("")
  industry     String             @default("")
  website      String             @default("")
  location     String             @default("")
  language     String             @default("fa")
  /// Language register (FORMAL / STANDARD / CASUAL, shared LanguageRegister); null = not set (docs/61)
  register     String?
  /// Keyword of the discovery this business was built from
  keyword      String?
  status       BusinessStatus     @default(ACTIVE)
  origin       BusinessOrigin     @default(MANUAL)
  buildState   BusinessBuildState @default(NONE)
  buildError   String?
  lastJobId    String?
  /// Web sources ({url,title}[]) collected by research builds
  sources      Json               @default("[]")
  /// Unverified facts / gaps reported by the last research build
  gaps         String[]
  researchedAt DateTime?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy     User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  topics        Topic[]
  sections      BusinessSection[]
  suggestions   BusinessSuggestion[]
  discoveries   BusinessDiscovery[]
  references    BusinessReference[]
  notes         BusinessNote[]
  assets        BusinessAsset[]
  facts         BusinessFact[]
  terms         BusinessTerm[]
  audits        BusinessAudit[]
  members       BusinessMember[]
  checklists    ChecklistTemplate[]
  pillars       ContentPillar[]
  styles        BusinessStyle[]
  offerings     BusinessOffering[]
  competitors   BusinessCompetitor[]
  segments      BusinessSegment[]
  questionSkips BusinessQuestionSkip[]

  @@index([status, updatedAt])
}

/// Grants a non-admin user access to a business, like TopicMember (docs/17-project-access.md).
model BusinessMember {
  id          String      @id @default(cuid())
  businessId  String
  userId      String
  access      AccessLevel
  grantedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User     @relation("BusinessMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("BusinessMemberGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([userId])
}

/// One profile section of a business (services, personas, brand book, …). Markdown text.
model BusinessSection {
  id           String             @id @default(cuid())
  businessId   String
  key          BusinessSectionKey
  content      String             @default("")
  source       SectionSource      @default(ADMIN)
  updatedById  String?
  /// When a person confirmed the current text; null = AI text nobody has reviewed yet
  reviewedAt   DateTime?
  reviewedById String?
  /// Who may change the text (docs/69): NONE = anyone with EDIT and the AI · AI_ONLY = no direct AI writes · ADMIN_ONLY = also only admins
  lock         SectionLock        @default(NONE)
  lockedAt     DateTime?
  lockedById   String?
  /// Why it is locked (≤ 200 characters); never written to the audit log
  lockNote     String             @default("")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy  User?                     @relation("SectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy User?                     @relation("SectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  lockedBy   User?                     @relation("SectionLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  revisions  BusinessSectionRevision[]

  @@unique([businessId, key])
}

/// Previous content of a section, stored whenever it is overwritten (restorable).
model BusinessSectionRevision {
  id          String        @id @default(cuid())
  sectionId   String
  content     String
  source      SectionSource
  createdById String?
  createdAt   DateTime      @default(now())

  section   BusinessSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sectionId, createdAt])
}

/// AI proposal for a section; applied only when the admin accepts it.
model BusinessSuggestion {
  id         String             @id @default(cuid())
  businessId String
  key        BusinessSectionKey
  content    String
  rationale  String             @default("")
  status     SuggestionStatus   @default(PENDING)
  jobId      String?
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

/// Keyword research run: AI searches the web and proposes real businesses for the keyword.
model BusinessDiscovery {
  id            String          @id @default(cuid())
  keyword       String
  location      String          @default("")
  language      String          @default("fa")
  count         Int             @default(5)
  notes         String          @default("")
  status        DiscoveryStatus @default(RESEARCHING)
  summary       String          @default("")
  candidates    Json            @default("[]")
  sources       Json            @default("[]")
  selectedIndex Int?
  businessId    String?
  jobId         String?
  error         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum ReferenceKind {
  URL
  GOOGLE_DOC
  TEXT
  INSTAGRAM
  WEBSITE
}

enum ReferenceStatus {
  PENDING
  READY
  FAILED
}

/// Admin-supplied source for AI builds/suggestions: a web page, a Google Docs/Drive file or a
/// pasted text. `content` is the text snapshot AI reads (refreshed on demand).
model BusinessReference {
  id              String          @id @default(cuid())
  businessId      String
  kind            ReferenceKind
  url             String          @default("")
  title           String          @default("")
  content         String          @default("")
  /// What code computed while reading an INSTAGRAM / WEBSITE source (`ReferenceAnalysis` in
  /// packages/shared/src/social.ts); null for the other kinds.
  analysis        Json?
  status          ReferenceStatus @default(PENDING)
  error           String?
  isActive        Boolean         @default(true)
  fetchedAt       DateTime?
  googleAccountId String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleAccount GoogleDriveAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chunks        ReferenceChunk[]

  @@index([businessId, createdAt])
}

/// A piece of a reference's text with its embedding, for picking the passages that fit a task
/// when the references are too big to send whole (docs/60). Vectors are plain double arrays: the
/// cosine is computed in code, so no Postgres extension is needed.
model ReferenceChunk {
  id          String   @id @default(cuid())
  referenceId String
  businessId  String
  idx         Int
  text        String
  embedding   Float[]
  /// The embedding model (`provider:model`); chunks of another model are not mixed in
  model       String
  /// Hash of the reference's text the chunks were cut from; a change makes them stale
  contentHash String
  createdAt   DateTime @default(now())

  reference BusinessReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([referenceId, idx])
  @@index([businessId])
}

/// Google account connected (OAuth, drive.readonly) to read private Google Docs/Drive files.
model GoogleDriveAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  googleSub     String
  /// AES-256-GCM encrypted refresh token (see secret-box.ts)
  refreshToken  String
  scope         String    @default("")
  /// Set when Google rejects the token (revoked / expired) — reconnect to clear
  error         String?
  lastUsedAt    DateTime?
  connectedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connectedBy User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  references  BusinessReference[]
}

enum NoteStatus {
  PENDING
  APPLIED
  FAILED
}

enum NoteApplyMode {
  DIRECT
  SUGGEST
}

/// An admin's explanation/correction; BUSINESS_REVISE updates the whole profile from it. Active
/// notes are also given to later builds and suggestions as standing corrections.
model BusinessNote {
  id          String               @id @default(cuid())
  businessId  String
  text        String
  apply       NoteApplyMode        @default(DIRECT)
  /// ResearchScope the revision was allowed to consult (NONE / REFERENCES / REFERENCE_SITES / WEB)
  scope       String               @default("NONE")
  status      NoteStatus           @default(PENDING)
  summary     String               @default("")
  changedKeys BusinessSectionKey[]
  error       String?
  isActive    Boolean              @default(true)
  jobId       String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

enum BusinessAssetKind {
  ARTICLE
  IMAGE
  BANNER
  ARTWORK
  CREATIVE
  VIDEO
  MOTION
}

/// A past piece of the business (article, image, banner, artwork, creative, video, motion).
/// BUSINESS_ASSET_ANALYZE turns it into a style analysis that every AI job of a linked topic gets.
model BusinessAsset {
  id             String            @id @default(cuid())
  businessId     String
  kind           BusinessAssetKind
  title          String            @default("")
  description    String            @default("")
  url            String            @default("")
  /// Article body, caption or transcript (pasted, uploaded as text, or fetched from `url`)
  text           String            @default("")
  fileName       String?
  mimeType       String?
  size           Int?
  /// Storage key of the uploaded original (FileStorageService)
  storageKey     String?
  /// Storage keys of JPEG previews: the downsized image, or frames captured from the video
  previews       String[]
  /// Public image URLs found on `url` (og:image), used when nothing was uploaded
  remoteImages   String[]
  analysisStatus AnalysisStatus    @default(NONE)
  analysis       Json?
  analysisError  String?
  lastJobId      String?
  isActive       Boolean           @default(true)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

enum FactCategory {
  IDENTITY
  OFFER
  PRICING
  NUMBERS
  CONTACT
  LEGAL
  OTHER
}

/// Exact value content may quote (price, fee, limit, number, date, contact, license …).
/// Admin-typed facts are verified; facts found by a research build start unverified.
model BusinessFact {
  id          String        @id @default(cuid())
  businessId  String
  label       String
  value       String
  category    FactCategory  @default(OTHER)
  sourceUrl   String        @default("")
  note        String        @default("")
  source      SectionSource @default(ADMIN)
  verified    Boolean       @default(true)
  /// After this day the value is no longer sent to AI (offers, rates, campaigns)
  validUntil  DateTime?
  isActive    Boolean       @default(true)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([businessId, category])
}

enum TermKind {
  USE
  AVOID
}

/// Brand terminology: USE = always write `term` (alternatives = wrong variants to catch);
/// AVOID = never write `term` (alternatives = replacements). Checked by code (checkTerms).
model BusinessTerm {
  id           String   @id @default(cuid())
  businessId   String
  term         String
  kind         TermKind @default(USE)
  alternatives String[]
  note         String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum AuditStatus {
  RUNNING
  READY
  FAILED
}

/// AI quality review of the whole profile (BUSINESS_AUDIT). `issues` holds AuditIssue[] with
/// their OPEN / FIXING / DISMISSED state.
model BusinessAudit {
  id          String      @id @default(cuid())
  businessId  String
  status      AuditStatus @default(RUNNING)
  score       Int?
  summary     String      @default("")
  strengths   String[]
  issues      Json        @default("[]")
  error       String?
  jobId       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

enum OfferingKind {
  PRODUCT
  SERVICE
  PLAN
  BUNDLE
}

enum OfferingStock {
  IN_STOCK
  LOW
  OUT
}

enum OfferingStatus {
  ACTIVE
  SEASONAL
  PAUSED
  DISCONTINUED
}

/// A product, service, plan or bundle of the business with its price (docs/67). Active, verified rows
/// reach the `[CATALOG]` prompt block, the quality gate's price check and the integrations' export.
model BusinessOffering {
  id              String         @id @default(cuid())
  businessId      String
  name            String
  /// Other spellings that count as this offering in the quality check
  aliases         String[]
  kind            OfferingKind   @default(PRODUCT)
  status          OfferingStatus @default(ACTIVE)
  /// 0 = do not promote · 1 = normal · 2 = priority · 3 = hero
  push            Int            @default(1)
  /// OUT counts as not available (prompt, quality gate); LOW is told to the model
  stock           OfferingStock  @default(IN_STOCK)
  /// Persian months (1 = Farvardin … 12 = Esfand) when demand peaks
  peakMonths      Int[]
  /// The line or product this one belongs to (same business, at most 3 levels — checked by the service, docs/73)
  parentId        String?
  /// Phrases never to write about this offering or its variants; found in a text → quality warning
  guardrails      String[]
  /// Offerings of the same business that sell well together / stand in for this one (checked by the service)
  complementIds   String[]
  substituteIds   String[]
  summary         String         @default("")
  features        String[]
  /// [{ feature, benefit, proof }] — what it has, what the customer gets, what backs it (docs/67 §4.9)
  claims          Json           @default("[]")
  priceAmount     Decimal?       @db.Decimal(18, 2)
  /// IRT (toman) | IRR (rial) | USD | EUR — always given with a price, never converted
  priceCurrency   String?
  priceFrom       Boolean        @default(false)
  priceUnit       String         @default("")
  priceValidUntil DateTime?
  availableFrom   DateTime?
  availableUntil  DateTime?
  url             String         @default("")
  /// Internal note; never sent to a model or an integration
  note            String         @default("")
  source          SectionSource  @default(ADMIN)
  /// Rows the admin types are verified; AI-proposed ones start unverified and inactive
  verified        Boolean        @default(true)
  isActive        Boolean        @default(true)
  /// The text in a source that backs an AI-proposed row (checked by code)
  evidence        String         @default("")
  sortOrder       Int            @default(0)
  jobId           String?
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy    User?              @relation("OfferingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// Deleting a line is refused while it has variants (the service answers 400); NoAction backs it up and,
  /// unlike Restrict, still lets deleting the whole business cascade through a line and its variants
  parent       BusinessOffering?  @relation("OfferingTree", fields: [parentId], references: [id], onDelete: NoAction)
  children     BusinessOffering[] @relation("OfferingTree")
  segmentLinks OfferingSegment[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([parentId])
}

enum SegmentKind {
  MARKET
  PERSONA
}

/// An audience of a business: a market segment or a persona, typed by the admin (docs/73)
model BusinessSegment {
  id           String      @id @default(cuid())
  businessId   String
  kind         SegmentKind @default(PERSONA)
  name         String
  summary      String      @default("")
  goals        String[]
  pains        String[]
  objections   String[]
  channels     String[]
  /// What message convinces them
  messageAngle String      @default("")
  /// Internal note; never sent to a model or an integration
  note         String      @default("")
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  updatedById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("SegmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  offerings OfferingSegment[]

  @@unique([businessId, name])
  @@index([businessId, kind])
}

/// Which audiences an offering is for; fit 2 = main, 1 = secondary
model OfferingSegment {
  offeringId String
  segmentId  String
  fit        Int    @default(2)

  offering BusinessOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  segment  BusinessSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([offeringId, segmentId])
  @@index([segmentId])
}

enum CompetitorKind {
  DIRECT
  INDIRECT
  REFERENCE
}

/// A competitor card the admin fills in (docs/70, phase 1). Never part of `BusinessApi.promptProfile`,
/// `[DOCUMENTS]`, the exports or similarity: it reaches a prompt only as text the admin pushes into the
/// COMPETITORS section ("add to profile").
model BusinessCompetitor {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  kind        CompetitorKind @default(DIRECT)
  website     String         @default("")
  instagram   String         @default("")
  /// How the competitor positions itself, in a sentence or two
  positioning String         @default("")
  /// Price level in the admin's words ("cheaper", "premium") — free text, never compared by code
  pricing     String         @default("")
  strengths   String[]
  weaknesses  String[]
  /// Where we differ from them
  difference  String         @default("")
  /// Internal note
  note        String         @default("")
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy User?                      @relation("CompetitorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sources   BusinessCompetitorSource[]

  @@unique([businessId, name])
  @@index([businessId, kind])
}

/// A page, site, Instagram account (Graph API or hand-typed data, never instagram.com) or pasted text about a
/// competitor, read by code into a snapshot (docs/70 phase 2). Like the card it never reaches a prompt,
/// an export or the similarity check.
model BusinessCompetitorSource {
  id           String          @id @default(cuid())
  competitorId String
  kind         StyleSourceKind
  url          String          @default("")
  title        String          @default("")
  content      String          @default("")
  /// What code computed while reading an INSTAGRAM / WEBSITE source (`ReferenceAnalysis`)
  analysis     Json?
  status       ReferenceStatus @default(PENDING)
  error        String?
  fetchedAt    DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  competitor BusinessCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("CompetitorSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitorId, createdAt])
}

/// A profile question the admin chose to skip (docs/72); it stays hidden until the skips are reset.
model BusinessQuestionSkip {
  id         String   @id @default(cuid())
  businessId String
  code       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
}

enum SourceBlockKind {
  URL
  DOMAIN
}

/// Research source the admin blacklisted: excluded from every future web research and purged
/// from stored business/discovery sources.
model BlockedSource {
  id          String          @id @default(cuid())
  kind        SourceBlockKind
  /// `host/path` for URL, `host` for DOMAIN (normalized — see sourceBlockValue in shared)
  value       String
  note        String          @default("")
  createdById String?
  createdAt   DateTime        @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([kind, value])
}

// ─────────────────────────────── Topics ───────────────────────────────

enum Platform {
  INSTAGRAM
  YOUTUBE
  TELEGRAM
  LINKEDIN
  X
  TIKTOK
  BLOG
  OTHER
  EITAA
  BALE
  RUBIKA
  APARAT
  NEWSLETTER
}

enum TopicStatus {
  ACTIVE
  ARCHIVED
}

/// Per-topic / per-business access for EDITOR/VIEWER accounts (admins see everything)
enum AccessLevel {
  VIEW
  EDIT
}

model Topic {
  id               String      @id @default(cuid())
  title            String
  description      String
  audience         String      @default("")
  platform         Platform    @default(INSTAGRAM)
  language         String      @default("fa")
  status           TopicStatus @default(ACTIVE)
  activeProfileId  String?     @unique
  /// Business this project produces content for; its profile is sent to every AI job of the topic
  businessId       String?
  /// Imitation style the drafts are written in (docs/64); one of the business's reviewed styles
  styleId          String?
  /// Set when the admin chose to produce content without sample contents (docs/19-optional-samples.md)
  samplesSkippedAt DateTime?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  business      Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  style         BusinessStyle?       @relation(fields: [styleId], references: [id], onDelete: SetNull)
  activeProfile ContentProfile?      @relation("ActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull)
  principles    Principle[]
  samples       SampleContent[]
  profiles      ContentProfile[]     @relation("TopicProfiles")
  ideationRuns  IdeationRequest[]
  ideas         Idea[]
  contents      Content[]
  brandDocs     BrandDocument[]
  members       TopicMember[]
  tags          Tag[]
  campaigns     Campaign[]
  editRuns      EditLearningRun[]
  aiFeedback    AiFeedback[]
  learnings     LearningSuggestion[]

  @@index([status, createdAt])
  @@index([businessId])
  @@index([styleId])
}

/// Label an editor puts on ideas and contents of one topic (docs/20-tags-campaigns.md).
model Tag {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  /// One of the palette keys in `TagColor` (packages/shared); validated by Zod, not the DB
  color       String   @default("slate")
  createdById String?
  createdAt   DateTime @default(now())

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]
  ideas    Idea[]

  @@unique([topicId, name])
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

/// Groups the contents of one topic that serve one goal; the dates are optional, so a campaign
/// without them works as a plain collection.
model Campaign {
  id          String         @id @default(cuid())
  topicId     String
  name        String
  description String         @default("")
  status      CampaignStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]

  @@unique([topicId, name])
  @@index([topicId, status])
}

/// Grants a non-admin user access to a project. The creator has EDIT without a row; a row
/// overrides that (e.g. VIEW). See docs/17-project-access.md.
model TopicMember {
  id          String      @id @default(cuid())
  topicId     String
  userId      String
  access      AccessLevel
  grantedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  topic     Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User  @relation("TopicMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("TopicMemberGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([topicId, userId])
  @@index([userId])
}

enum PrincipleKind {
  MUST
  AVOID
  PREFER
}

/// topicId = null → global principle applied to every topic
model Principle {
  id        String        @id @default(cuid())
  topicId   String?
  kind      PrincipleKind
  text      String
  isActive  Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

// ─────────────────────────────── Samples ───────────────────────────────

enum MediaType {
  ARTICLE
  VIDEO
  IMAGE
  POST
  AUDIO
  UNKNOWN
}

enum FetchStatus {
  PENDING
  FETCHED
  FAILED
  SKIPPED
}

enum AnalysisStatus {
  NONE
  QUEUED
  DONE
  FAILED
}

model SampleContent {
