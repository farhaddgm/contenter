// ─────────────────────────────── Contents ───────────────────────────────

enum ContentStatus {
  GENERATING
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum VersionSource {
  AI
  ADMIN
}

/// Where an IN_REVIEW content waits: with an editor first, then (optionally) the final approver
enum ReviewStage {
  EDITORIAL
  FINAL
}

enum ReviewDecision {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  WITHDRAWN
  REOPENED
  /// the text changed after review, so the content went back to DRAFT
  RESET
}

model Content {
  id               String        @id @default(cuid())
  topicId          String
  ideaId           String?
  profileId        String?
  campaignId       String?
  /// Set on a content made for another platform from `sourceContentId` (docs/23-repurposing.md)
  platform         Platform?
  sourceContentId  String?
  title            String
  brief            String        @default("")
  format           ContentFormat @default(POST)
  status           ContentStatus @default(GENERATING)
  /// Set while status is IN_REVIEW (docs/21-review-workflow.md)
  reviewStage      ReviewStage?
  submittedById    String?
  submittedAt      DateTime?
  /// Planned publish time; only an APPROVED content is scheduled (docs/22-calendar-publishing.md)
  scheduledAt      DateTime?
  /// Set by hand once the content is live elsewhere; a published content is frozen
  publishedAt      DateTime?
  publishedUrl     String?
  /// An admin marked this approved content as an example of the brand's voice (docs/49-golden-examples.md); cleared when the text changes
  goldenAt         DateTime?
  /// The content pillar of the business this piece covers (docs/50-coverage-map.md); null = unlabeled
  pillarId         String?
  /// Drafts written together for one idea share this id; null = a single draft (docs/51-draft-variants.md)
  variantGroupId   String?
  /// The fixed writing angle this draft was asked for (`VariantAngle` in packages/shared)
  variantAngle     String?
  /// The `scheduledAt` the "time to publish" reminder was already sent for (docs/25-notifications.md)
  dueNotifiedFor   DateTime?
  currentVersionId String?       @unique
  lastJobId        String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  topic          Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  idea           Idea?                  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  profile        ContentProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar         ContentPillar?         @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  currentVersion ContentVersion?        @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContentVersion[]       @relation("ContentVersions")
  tags           Tag[]
  submittedBy    User?                  @relation("ContentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  source         Content?               @relation("Repurposed", fields: [sourceContentId], references: [id], onDelete: SetNull)
  repurposed     Content[]              @relation("Repurposed")
  reviews        ContentReview[]
  comments       ContentComment[]
  metrics        ContentMetric[]
  notifications  Notification[]
  checklistTicks ContentChecklistTick[]

  @@index([topicId, status, createdAt])
  @@index([status, updatedAt])
  @@index([campaignId])
  @@index([pillarId])
  @@index([variantGroupId])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([sourceContentId])
}

/// One step of a content's review history (submit, approve, request changes …).
model ContentReview {
  id        String         @id @default(cuid())
  contentId String
  /// The version the decision was about
  versionId String?
  stage     ReviewStage?
  decision  ReviewDecision
  actorId   String?
  note      String         @default("")
  createdAt DateTime       @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
}

/// A comment on a draft; replies are one level deep (`parentId` points at a top-level comment).
model ContentComment {
  id           String    @id @default(cuid())
  contentId    String
  /// The version the author was looking at
  versionId    String?
  parentId     String?
  authorId     String?
  body         String
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  content    Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version    ContentVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  parent     ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ContentComment[] @relation("CommentReplies")
  author     User?            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy User?            @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
}

model ContentVersion {
  id        String        @id @default(cuid())
  contentId String
  version   Int
  title     String
  body      String
  hashtags  String[]
  cta       String        @default("")
  notes     String        @default("")
  selfCheck Json?
  feedback  String?
  source    VersionSource @default(AI)
  jobId     String?
  createdAt DateTime      @default(now())

  content   Content          @relation("ContentVersions", fields: [contentId], references: [id], onDelete: Cascade)
  currentOf Content?         @relation("CurrentVersion")
  comments  ContentComment[]

  @@unique([contentId, version])
}

// ───────────────────────── Feedback on AI output ─────────────────────────
// See docs/46-ai-feedback.md. Mirrors packages/shared/src/feedback.ts.

enum FeedbackTarget {
  CONTENT_VERSION
  PROFILE
}

enum FeedbackRating {
  UP
  DOWN
}

/// One person's 👍 / 👎 on one AI output. `jobId` is the job that made it (prompt version and model
/// are read from there); `topicId` is kept so access and counts need no join.
model AiFeedback {
  id         String         @id @default(cuid())
  userId     String
  targetType FeedbackTarget
  targetId   String
  topicId    String
  jobId      String?
  rating     FeedbackRating
  /// One of FeedbackReason (checked by Zod); only on a DOWN
  reason     String?
  note       String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([topicId, targetType])
  @@index([jobId])
  @@index([createdAt])
}

// ───────────────────────── Publishing checklist ─────────────────────────
// See docs/45-publish-checklist.md. Mirrors packages/shared/src/checklist.ts.

/// The points a person confirms before a content is scheduled: one row per business and platform
/// (platform null = every platform). `items` is ChecklistItem[]; each keeps its id when edited.
model ChecklistTemplate {
  id          String    @id @default(cuid())
  businessId  String
  platform    Platform?
  items       Json
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// A person ticked one point (`itemId` of a template item) of a content. Cleared when the reviewed text changes.
model ContentChecklistTick {
  id          String   @id @default(cuid())
  contentId   String
  itemId      String
  checkedById String?
  createdAt   DateTime @default(now())

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  checkedBy User?   @relation("ChecklistTicker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@unique([contentId, itemId])
}

// ───────────────────────── Learning from edits ─────────────────────────
// See docs/30-learn-from-edits.md. Mirrors packages/shared/src/edit-learning.ts.

/// One analysis of the edited approved contents of a topic (one LEARN_FROM_EDITS job).
model EditLearningRun {
  id             String   @id @default(cuid())
  topicId        String
  jobId          String?
  /// How many (AI draft, approved text) pairs the model saw
  pairCount      Int
  /// Mean share of words changed over those pairs, 0–1 (counted by code)
  avgChangeRatio Float
  createdAt      DateTime @default(now())

  topic       Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  suggestions LearningSuggestion[]

  @@index([topicId, createdAt])
}

/// A principle the model proposes from edits that repeat; becomes a Principle only when accepted.
model LearningSuggestion {
  id          String           @id @default(cuid())
  topicId     String
  runId       String
  kind        PrincipleKind
  /// One of EditCategory (checked by Zod, not an enum, so the list can grow without a migration)
  category    String
  text        String
  rationale   String           @default("")
  /// EditEvidence[] — built by code from real pairs, never copied from the model
  evidence    Json
  status      SuggestionStatus @default(PENDING)
  principleId String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  topic Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  run   EditLearningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([topicId, status])
  @@index([runId])
}

/// Numbers read by hand from a platform for a published content, one reading per day
/// (docs/32-performance-metrics.md). Counters are cumulative; the newest reading is the current state.
model ContentMetric {
  id          String   @id @default(cuid())
  contentId   String
  /// The calendar day (UTC midnight) the numbers were read.
  measuredAt  DateTime @db.Date
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  clicks      Int?
  conversions Int?
  revenue     Float?
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("MetricAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([contentId, measuredAt])
  @@index([measuredAt])
}

// ─────────────────────────────── Notifications ───────────────────────────────

enum NotificationEvent {
  REVIEW_SUBMITTED
  REVIEW_FINAL_NEEDED
  REVIEW_APPROVED
  REVIEW_CHANGES_REQUESTED
  REVIEW_REJECTED
  COMMENT_ADDED
  COMMENT_REPLIED
  CONTENT_DUE
  BACKUP_VERIFY_FAILED
  AI_FALLBACK_USED
  AI_BUDGET_WARNING
  AI_BUDGET_EXCEEDED
}

enum DeliveryChannel {
  EMAIL
  WEBHOOK
}

enum DeliveryStatus {
  SENT
  FAILED
}

/// One notification of one user. The text is not stored: `params` is rendered in the reader's
/// language (packages/shared/src/notifications.ts).
model Notification {
  id        String            @id @default(cuid())
  userId    String
  event     NotificationEvent
  contentId String?
  params    Json
  /// App path the notification leads to
  link      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// A user's choice per event; a missing row means the defaults (NOTIFICATION_DEFAULTS)
model NotificationPreference {
  id     String            @id @default(cuid())
  userId String
  event  NotificationEvent
  inApp  Boolean           @default(true)
  email  Boolean           @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event])
}

/// Outcome of one e-mail or webhook send, kept for a few weeks so a failing channel can be found
model NotificationDelivery {
  id        String            @id @default(cuid())
  channel   DeliveryChannel
  event     NotificationEvent
  /// The address, or the host of the webhook
  target    String
  status    DeliveryStatus
  error     String?
  attempts  Int               @default(1)
  createdAt DateTime          @default(now())

  @@index([createdAt])
}

// ─────────────────────────────── AI & Ops ───────────────────────────────

enum AiJobType {
  ANALYZE_SAMPLE
  BUILD_PROFILE
  IDEATE
  GENERATE_CONTENT
  REVISE_CONTENT
  SMART_CHAT
  BUSINESS_DISCOVER
  BUSINESS_BUILD
  BUSINESS_SUGGEST
  BUSINESS_REVISE
  BUSINESS_ASSET_ANALYZE
  BUSINESS_AUDIT
  REPURPOSE_CONTENT
  LEARN_FROM_EDITS
  /// Splits a business reference into chunks and embeds them (docs/60)
  EMBED_REFERENCE
  /// Reads the sources of an imitation style and writes its guide (docs/64)
  BUSINESS_STYLE_BUILD
  /// Proposes catalog rows from the profile and references; code checks each against its quote (docs/67)
  BUSINESS_OFFERINGS_EXTRACT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  /// Economy mode: the model call is with the vendor's batch queue (docs/60)
  WAITING
}

model AiJob {
  id              String      @id @default(cuid())
  type            AiJobType
  status          AiJobStatus @default(QUEUED)
  targetType      String
  targetId        String
  topicId         String?
  input           Json
  output          Json?
  error           String?
  attempts        Int         @default(0)
  model           String?
  inputTokens     Int         @default(0)
  outputTokens    Int         @default(0)
  cacheReadTokens Int         @default(0)
  /// Characters of the prompts (system + user) the job sent, summed over its model calls; null when
  /// not measured (web research, images, older jobs). Used to learn characters per token (docs/66)
  promptChars     Int?
  costUsd         Float       @default(0)
  promptKey       String?
  promptVersion   Int?
  createdById     String?
  /// Run through the vendor's batch API: about half the price, result within 24 hours (docs/60)
  economy         Boolean     @default(false)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy  User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  batchCalls AiBatchCall[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
  @@index([topicId])
}

enum AiBatchStatus {
  PENDING
  SUBMITTED
  DONE
  FAILED
}

/// One model call of an economy-mode job, waiting for or holding its batch result. A job is run
/// again when its calls are done and replays earlier calls from here by `seq` (docs/60).
model AiBatchCall {
  id        String        @id @default(cuid())
  jobId     String
  /// Order of the call inside the job's run: 0, 1, ...
  seq       Int
  /// `provider:model` the call was prepared for
  model     String
  /// The vendor request body, prepared by the provider (plain JSON)
  params    Json
  status    AiBatchStatus @default(PENDING)
  /// The vendor's batch id once submitted
  batchRef  String?
  /// The vendor's raw answer for this call
  result    Json?
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@index([status, createdAt])
  @@index([batchRef])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String
  version   Int
  system    String
  user      String
  notes     String   @default("")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@index([key, isActive])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────── Smart (اسمارت) ───────────────────────────────

enum InteractionSource {
  CLIENT
  SERVER
}

/// Opt-in detailed interaction log (SystemSetting smart.detailedLogging).
model InteractionLog {
  id         String            @id @default(cuid())
  userId     String?
  sessionId  String?
  source     InteractionSource
  type       String
  route      String?
  method     String?
  path       String?
  statusCode Int?
  durationMs Int?
  target     String?
  meta       Json?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

enum ErrorSource {
  SERVER
  CLIENT
  AI_JOB
}

enum ErrorStatus {
  NEW
  SEEN
  RESOLVED
  IGNORED
}

enum ErrorCategory {
  DATABASE
  VALIDATION
  AUTH
  NETWORK
  AI
  NOT_FOUND
  CLIENT_RUNTIME
  UNKNOWN
}

/// Errors raised by the server, the web client or AI jobs. Deduplicated by fingerprint.
model AppError {
  id          String        @id @default(cuid())
  fingerprint String
  source      ErrorSource
  category    ErrorCategory @default(UNKNOWN)
  message     String
  hint        String?
  detail      String?
  statusCode  Int?
  method      String?
  path        String?
  route       String?
  jobId       String?
  userId      String?
  context     Json?
  count       Int           @default(1)
  status      ErrorStatus   @default(NEW)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversations SmartConversation[]
  issues        WalkerIssue[]

  @@index([fingerprint, status])
  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}

enum ConversationKind {
  WALKER
  ERROR
}

enum SmartMessageRole {
  USER
  ASSISTANT
}

enum SmartMessageStatus {
  PENDING
  DONE
  FAILED
}

model SmartConversation {
  id        String           @id @default(cuid())
  userId    String
  kind      ConversationKind
  title     String           @default("")
  errorId   String?
  topicId   String?
  route     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  error    AppError?      @relation(fields: [errorId], references: [id], onDelete: SetNull)
  messages SmartMessage[]
  issues   WalkerIssue[]

  @@index([userId, updatedAt])
}

model SmartMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           SmartMessageRole
  content        String             @default("")
  status         SmartMessageStatus @default(DONE)
  /// Context snapshot captured when the admin sent the message (route, topic, walker step).
  context        Json?
  jobId          String?
  createdAt      DateTime           @default(now())

  conversation SmartConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  issues       WalkerIssue[]

  @@index([conversationId, createdAt])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum IssueSource {
  WALKER_CHAT
  ERROR_CHAT
}

/// "دفتر خطاهای واکر" — issues saved by the admin from an AI answer, to be fixed later.
model WalkerIssue {
  id             String      @id @default(cuid())
  title          String
  content        String
  source         IssueSource
  status         IssueStatus @default(OPEN)
  conversationId String?
  messageId      String?
  errorId        String?
  topicId        String?
  route          String?
  context        Json?
  resolutionNote String?
  resolvedAt     DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  conversation SmartConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      SmartMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  error        AppError?          @relation(fields: [errorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// A theme the business wants its content to cover (docs/50-coverage-map.md). `targetShare` is the wanted
/// percent of the labeled content; deleting a pillar leaves its contents unlabeled.
model ContentPillar {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  targetShare Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contents Content[]

  @@unique([businessId, name])
  @@index([businessId, order])
}

/// A personal API key (docs/52-api-keys.md). Only a SHA-256 of the key is stored, never the key;
/// `prefix` (first characters, unique) finds the row. The key carries its owner's identity
/// narrowed by `scopes` (`ApiKeyScope` in packages/shared).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique
  hash       String
  scopes     String[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum StyleSourceKind {
  INSTAGRAM
  WEBSITE
  URL
  TEXT
}

/// A named writing style learned from other brands' pages and adapted to one business (docs/64).
/// Not the business's own material, so it never mixes with `BusinessReference`.
model BusinessStyle {
  id          String             @id @default(cuid())
  businessId  String
  name        String
  /// What the admin wants taken (or left) from the sources
  direction   String             @default("")
  buildState  BusinessBuildState @default(NONE)
  buildError  String?
  lastJobId   String?
  summary     String             @default("")
  /// `StyleTrait[]` (packages/shared business-style.ts)
  traits      Json               @default("[]")
  /// Writing instructions adapted to this business; goes into drafts as [STYLE]
  guide       String             @default("")
  caveats     String[]
  builtAt     DateTime?
  /// AI output stays unreviewed until the admin confirms or edits it
  reviewedAt  DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sources   StyleSource[]
  topics    Topic[]

  @@unique([businessId, name])
  @@index([businessId, updatedAt])
}

/// A page of another brand (Instagram account, site, single page or pasted text) a style learns from.
model StyleSource {
  id          String          @id @default(cuid())
  styleId     String
  kind        StyleSourceKind
  url         String          @default("")
  title       String          @default("")
  content     String          @default("")
  /// What code computed while reading an INSTAGRAM / WEBSITE source (`ReferenceAnalysis`)
  analysis    Json?
  status      ReferenceStatus @default(PENDING)
  error       String?
  fetchedAt   DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  style     BusinessStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([styleId, createdAt])
}
