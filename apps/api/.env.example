# ── Runtime ─────────────────────────────────────────
NODE_ENV=development
# api | worker | all  (all = HTTP + queue worker in one process, for local dev)
APP_ROLE=all
PORT=4000
CORS_ORIGINS=http://localhost:5173

# ── Data ────────────────────────────────────────────
DATABASE_URL=postgresql://contenter:contenter@localhost:5432/contenter
# bullmq (Redis, recommended) | inline (in-process, no Redis)
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# ── Auth ────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
# Public origin of the web app (Google sign-in redirects back here)
APP_URL=http://localhost:5173
# Application owner — always ADMIN, the only one who manages Google access (Settings)
OWNER_EMAIL=farhad.dgm@gmail.com

# ── Sign in with Google (optional; docs/11-google-login.md) ──
# OAuth "Web application" client from Google Cloud Console. Empty = Google button hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI on the client
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ── Google Drive for private Google Docs (optional; docs/14-business-references.md) ──
# Same OAuth client. Default redirect: GOOGLE_REDIRECT_URI with /auth/google/callback
# replaced by /google-drive/callback — register it in Google Cloud and enable the Drive API.
GOOGLE_DRIVE_REDIRECT_URI=
# Encrypts stored Google refresh tokens (min 16 chars). Empty = derived from JWT_REFRESH_SECRET;
# changing either one means the Google accounts must be connected again.
DATA_ENCRYPTION_KEY=

# ── Uploaded brand assets (docs/15-business-notes-and-assets.md) ──
# Directory for uploaded images/videos (Docker sets /data/uploads on a shared volume).
UPLOAD_DIR=uploads
# Largest accepted file in MB (nginx allows 220 MB).
UPLOAD_MAX_MB=200

# ── AI ──────────────────────────────────────────────
# live = each task goes to the vendor of the model chosen in Settings (پنل ← تنظیمات)
# mock = no API calls, schema-valid placeholder output
AI_PROVIDER=mock
# Keys for the vendors you use (leave empty to disable that vendor)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (proxy/gateway); empty = api.openai.com
OPENAI_BASE_URL=
# Fallback when no default model is saved in Settings. Format: provider:model
AI_DEFAULT_MODEL=anthropic:claude-opus-5
AI_REFUSAL_FALLBACK=true

# ── Media fetching ──────────────────────────────────
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5000000
# Iranian hosts (PodSpace …) often drop requests from servers abroad → timeouts. Point this at an
# HTTP proxy inside Iran to read them; FETCH_PROXY_HOSTS = domain suffixes routed through it.
FETCH_PROXY_URL=
FETCH_PROXY_HOSTS=ir
FETCH_ALLOW_PRIVATE=false

# ── Seed ────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@contenter.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Service API for Docoo (optional; docs/18-docoo-integration.md) ──
# Read-only access to businesses for other applications. Empty = switched off.
# Generate with: openssl rand -hex 32   (must be at least 32 characters)
INTEGRATION_TOKEN=
