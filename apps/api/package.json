{
  "name": "@contenter/api",
  "version": "0.23.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Contenter HTTP API and AI worker (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "eval": "node --env-file-if-exists=.env --require ts-node/register/transpile-only src/evals/cli.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@contenter/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.12",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "openai": "^7.37.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.12.2",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "deepmerge-ts": "^8.0.2",
    "eslint": "^10.13.0",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
